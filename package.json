{
    "name": "boardwall",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 5178 --strictPort",
        "api": "tsx watch server/index.ts",
        "pg:start": "tsx dev/dev-pg.ts start",
        "pg:stop": "tsx dev/dev-pg.ts stop",
        "db:push": "drizzle-kit push",
        "build": "tsc --noEmit && vite build",
        "lint": "eslint . && biome lint .",
        "lint:fix": "biome lint --write . && eslint --fix .",
        "format": "biome format --write . && eslint --fix .",
        "format:check": "biome format . && eslint .",
        "check": "biome check . && eslint ."
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.3",
        "@tailwindcss/vite": "^4.1.0",
        "drizzle-orm": "^0.45.4",
        "fastify": "^5.12.5",
        "lucide-react": "^0.468.0",
        "postgres": "^3.4.9",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "tailwindcss": "^4.1.0",
        "vite": "^7.1.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^24.19.1",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "drizzle-kit": "^0.31.11",
        "embedded-postgres": "18.4.0-beta.17",
        "eslint": "^10.12.0",
        "jiti": "^2.7.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.71.0"
    }
}
