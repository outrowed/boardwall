{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "types": ["vite/client"]
    },
    "include": ["src", "shared", "server", "tests", "vite.config.ts"],
    "exclude": ["node_modules", "dist", "dist-server", "data", "dev"]
}
